<Page
    x:Class="MiHome.App.Views.SchedulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Click="Add_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="新建定时" />
                </StackPanel>
            </Button>
            <TextBlock Text="到点自动执行并提示，错过不补执行只提醒；需应用保持运行（最小化到托盘也算）。"
                       VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="ListPanel" Grid.Row="1" Spacing="8" Padding="0,0,0,24" />
    </Grid>
</Page>
