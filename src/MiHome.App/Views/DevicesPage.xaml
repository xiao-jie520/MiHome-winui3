<Page
    x:Class="MiHome.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0">
            <Button x:Name="RefreshButton" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
            <Button x:Name="VoiceButton" Click="Voice_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Microphone" />
                    <TextBlock Text="小爱语音" />
                </StackPanel>
            </Button>
            <ProgressRing x:Name="Ring" Width="28" Height="28" IsActive="False" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" Spacing="8" Padding="0,0,0,24" />
        </ScrollViewer>
    </Grid>
</Page>
