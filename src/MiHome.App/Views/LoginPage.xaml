<Page
    x:Class="MiHome.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="480">
        <TextBlock Text="登录米家账号" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="正在获取登录二维码…" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <Border x:Name="QrBorder" Background="White" CornerRadius="8" Padding="12"
                HorizontalAlignment="Center" Visibility="Collapsed">
            <Image x:Name="QrImage" Width="220" Height="220" Stretch="Uniform" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Button x:Name="RefreshButton" Content="刷新二维码" Click="RefreshButton_Click" Visibility="Collapsed" />
            <Button x:Name="LogoutButton" Content="退出登录" Click="LogoutButton_Click" Visibility="Collapsed" />
        </StackPanel>

        <muxc:ProgressRing x:Name="Ring" IsActive="True" Width="36" Height="36" />
        <TextBlock Text="请使用米家 APP 扫描二维码登录，登录凭据长期复用。" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
